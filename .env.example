# URL pública del sitio (se usa en enlaces de correos, Mercado Pago y descargas)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sesiones: 32+ caracteres aleatorios (obligatorio en producción)
SESSION_SECRET=

# Usuario administrador que se crea al iniciar por primera vez
ADMIN_EMAIL=admin@tu-dominio.com.ar
ADMIN_PASSWORD=

# Mercado Pago Checkout Pro (https://www.mercadopago.com.ar/developers/panel)
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (opcional, valida la firma de las notificaciones)
MP_WEBHOOK_SECRET=

# Contacto
NEXT_PUBLIC_WHATSAPP=5491100000000
NEXT_PUBLIC_CONTACT_EMAIL=hola@tu-dominio.com.ar

# Carpeta de datos persistentes: base de datos, portadas y PDF subidos (por defecto ./data).
# En Railway: DATA_DIR=/data, con un volumen montado en /data.
# DATA_DIR=

# Correos (SMTP). Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=tu cuenta de Gmail y SMTP_PASS=una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente que ven los clientes, por ejemplo: Entre Líneas <tu-cuenta@gmail.com>
MAIL_FROM=
# A dónde llegan los avisos de ventas nuevas (si se deja vacío, a ADMIN_EMAIL)
STORE_NOTIFY_EMAIL=
